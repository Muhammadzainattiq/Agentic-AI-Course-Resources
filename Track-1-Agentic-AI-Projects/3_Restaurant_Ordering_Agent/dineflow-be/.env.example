# ─────────────────────────────────────────────────────────────────────────────
# DineFlow backend — copy to `.env` and fill in. Never commit the real `.env`.
# Variables marked REQUIRED have no default; the app refuses to boot without them.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=DineFlow
ENVIRONMENT=development            # development | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
PORT=8000                          # Hugging Face Spaces overrides this to 7860

# ── LLM / Agent (OpenAI) ─────────────────────────────────────────────────────
# REQUIRED — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-5                 # main ordering agent
OPENAI_EXTRACTOR_MODEL=gpt-5-mini  # cheap model for the memory extractor
AGENT_MAX_TURNS=12                 # tool-call loop cap per user message
AGENT_REASONING_EFFORT=low         # low | medium | high

# ── Postgres / Neon — short-term memory + ordering ───────────────────────────
# REQUIRED — Neon dashboard → Connection string → "Pooled connection".
# Must include ?sslmode=require. Use the *pooled* host for serverless deploys.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/dineflow?sslmode=require
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5                 # keep low; serverless containers are many and small

# ── MongoDB — long-term memory ───────────────────────────────────────────────
# REQUIRED — MongoDB Atlas → Connect → Drivers → Python.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=dineflow
MONGODB_MEMORIES_COLLECTION=long_term_memories

# ── Memory behaviour ─────────────────────────────────────────────────────────
SHORT_TERM_WINDOW=20               # turns of transcript replayed into each run
LONG_TERM_MAX_INJECTED=12          # memories injected into the system prompt
MEMORY_EXTRACTION_ENABLED=true     # set false to disable the extractor entirely

# ── Restaurant identity (surfaces in the system prompt + totals) ─────────────
RESTAURANT_NAME=DineFlow Kitchen
RESTAURANT_CURRENCY=PKR


# ── Authentication ───────────────────────────────────────────────────────────
# REQUIRED — signs the JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080            # one week
CHEF_EMAIL=chef@gmail.com           # the single kitchen account, seeded on startup
CHEF_PASSWORD=chef@1234

# ── Security / CORS ──────────────────────────────────────────────────────────
# Comma-separated. Add your Vercel URL in production.
CORS_ALLOW_ORIGINS=http://localhost:3000,https://dineflow.vercel.app
API_AUTH_TOKEN=                    # optional shared secret between FE and BE
