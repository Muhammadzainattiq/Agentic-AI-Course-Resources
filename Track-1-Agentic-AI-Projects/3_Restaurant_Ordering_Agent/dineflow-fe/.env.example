# ─────────────────────────────────────────────────────────────────────────────
# DineFlow frontend — copy to `.env.local` and fill in.
# All of these are SERVER-side only (no NEXT_PUBLIC_ prefix), so the backend URL
# and token never reach the browser. The browser talks to /api/* route handlers.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED in production — your FastAPI backend on Hugging Face Docker Spaces.
# Local dev default is http://localhost:8000 if unset.
BACKEND_URL=https://<your-hf-username>-dineflow-be.hf.space

# Must match API_AUTH_TOKEN in the backend's .env. Leave blank if unused.
API_AUTH_TOKEN=

# How long to wait on a backend agent turn before giving up (ms).
BACKEND_TIMEOUT_MS=60000
